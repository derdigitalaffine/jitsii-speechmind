# ---------------------------------------------------------------------------
# Jitsi + SpeechMind – Konfiguration
# Am einfachsten mit ./scripts/setup.sh erzeugen lassen (setzt alle Secrets).
# ---------------------------------------------------------------------------

# --- Domains & TLS ----------------------------------------------------------
# Zwei DNS-Einträge (A/AAAA) auf diesen Server:
MEET_DOMAIN=meet.example.com
PORTAL_DOMAIN=portal.example.com
# Vorbelegung für Let's Encrypt (Umschalten später in der Portal-Oberfläche:
# Admin > HTTPS & Zertifikat). Gestartet wird immer mit selbst signiertem Zertifikat.
ACME_EMAIL=admin@example.com

PUBLIC_URL=https://meet.example.com
# Öffentliche IP des Servers (für die Videobridge, wichtig hinter NAT)
JVB_ADVERTISE_IPS=203.0.113.10
JVB_PORT=10000

# --- Allgemein --------------------------------------------------------------
CONFIG=./data
TZ=Europe/Berlin
RESTART_POLICY=unless-stopped
# Für Produktion auf einen festen Release pinnen, z. B. stable-10314
JITSI_IMAGE_VERSION=stable-11031

# --- Authentifizierung (JWT, ausgestellt vom Portal) ------------------------
ENABLE_AUTH=1
AUTH_TYPE=jwt
# Gäste dürfen per Link beitreten, sobald ein angemeldeter Moderator da ist
# Wird in docker-compose.yml fest auf 0 gesetzt: Räume ohne Anmeldung laufen über die
# Portal-Zugriffsregeln (Admin > Benutzer > Konferenzen ohne Anmeldung).
ENABLE_GUESTS=0
JWT_APP_ID=jitsi-speechmind
JWT_APP_SECRET=CHANGE_ME
JWT_ACCEPTED_ISSUERS=jitsi-speechmind
JWT_ACCEPTED_AUDIENCES=jitsi
JWT_TOKEN_TTL_MINUTES=240

# --- Aufzeichnung (Jibri) ---------------------------------------------------
ENABLE_RECORDING=1
ENABLE_FILE_RECORDING_SHARING=0
ENABLE_LIVESTREAMING=0
ENABLE_TRANSCRIPTIONS=0

# --- Sonstige Jitsi-Optionen ------------------------------------------------
ENABLE_LOBBY=1
ENABLE_PREJOIN_PAGE=1
ENABLE_WELCOME_PAGE=1
DEFAULT_LANGUAGE=de
ENABLE_XMPP_WEBSOCKET=1
ENABLE_COLIBRI_WEBSOCKET=1

# --- Interne XMPP-Passwörter (setup.sh erzeugt Zufallswerte) ---------------
JICOFO_AUTH_PASSWORD=CHANGE_ME
JVB_AUTH_PASSWORD=CHANGE_ME
JIGASI_XMPP_PASSWORD=CHANGE_ME
JIGASI_TRANSCRIBER_PASSWORD=CHANGE_ME
JIBRI_RECORDER_PASSWORD=CHANGE_ME
JIBRI_XMPP_PASSWORD=CHANGE_ME

# --- Branding ---------------------------------------------------------------
BRAND_NAME=Verbandsgemeinde Otterbach-Otterberg
BRAND_PRODUCT=Videokonferenzserver

# --- Portal -----------------------------------------------------------------
# Schlüssel für Sitzungen und die Verschlüsselung gespeicherter API-Keys
PORTAL_SECRET_KEY=CHANGE_ME
# Standard-Admin (wird nur beim allerersten Start angelegt und muss beim ersten
# Login ein eigenes Passwort vergeben). Ohne Passwort erzeugt das Portal eines
# und schreibt es einmalig ins Log: docker compose logs portal
PORTAL_ADMIN_EMAIL=admin@example.com
PORTAL_ADMIN_PASSWORD=CHANGE_ME
