# Vorlage für den allerersten Start: selbst signierte Zertifikate (Caddys eigene CA).
# Danach verwaltet das Portal die Datei (Admin > HTTPS & Zertifikat) und kann auf
# Let's Encrypt umstellen. Änderungen hier wirken nur, solange data/caddy/conf/Caddyfile fehlt.

# Videokonferenz
{$MEET_DOMAIN} {
	tls internal
	encode gzip
	# Design der Konferenzoberfläche (dynamicBrandingUrl) und Logo kommen vom Portal
	handle /branding/* {
		reverse_proxy portal:8000
	}
	handle {
		reverse_proxy web:80
	}
}

# Portal (Login, Benutzer, Aufnahmen, Benachrichtigungen, SpeechMind)
{$PORTAL_DOMAIN} {
	tls internal
	encode gzip
	request_body {
		max_size 60MB
	}
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}
	# Nur die Rechtstexte unter /recht-embed dürfen in fremden Seiten (iframe) erscheinen
	@noembed not path /recht-embed /recht-embed/*
	header @noembed ?X-Frame-Options "DENY"
	reverse_proxy portal:8000
}
