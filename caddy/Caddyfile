{
	email {$ACME_EMAIL}
}

# Videokonferenz
{$MEET_DOMAIN} {
	encode gzip
	reverse_proxy web:80
}

# Portal (Login, Benutzer, Aufnahmen, Benachrichtigungen, SpeechMind)
{$PORTAL_DOMAIN} {
	encode gzip
	request_body {
		max_size 10MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
	}
	reverse_proxy portal:8000
}
